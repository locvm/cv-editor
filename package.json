{
  "name": "cv-editor",
  "version": "1.0.0",
  "description": "PDF Privacy Redaction Server - Removes phone numbers and emails from PDF documents",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:patterns": "jest tests/patterns.test.js",
    "test:api": "NODE_OPTIONS='--experimental-vm-modules' jest tests/api.test.js",
    "test:pdf": "NODE_OPTIONS='--experimental-vm-modules' jest tests/pdfProcessing.test.js",
    "test:security": "NODE_OPTIONS='--experimental-vm-modules' jest tests/security.test.js",
    "test:edge": "NODE_OPTIONS='--experimental-vm-modules' jest tests/edgeCases.test.js",
    "vercel-build": "echo 'Building for Vercel serverless...'"
  },
  "keywords": [
    "pdf",
    "redaction",
    "privacy",
    "cv",
    "resume"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "node-qpdf2": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "~6.5.438",
    "unpdf": "^2.1.0"
  },
  "optionalDependencies": {
    "canvas": "^3.2.3"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
